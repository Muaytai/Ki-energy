# ==============================================================================
# MindAvatar SaaS - Environment Configuration
# ZERO-COST AI STACK: OpenRouter (free tier) + Sentence-Transformers (CPU) + Edge-TTS
# ==============================================================================

# --- Django Backend ---
DJANGO_SECRET_KEY=change-this-to-a-secure-random-secret-key-in-production
DEBUG=1
ALLOWED_HOSTS=localhost,127.0.0.1,backend

# --- PostgreSQL + pgvector ---
POSTGRES_DB=mindavatar_db
POSTGRES_USER=mindavatar_user
POSTGRES_PASSWORD=mindavatar_password
POSTGRES_HOST=db
POSTGRES_PORT=5432

# --- Redis (Broker & Cache) ---
REDIS_URL=redis://redis:6379/0

# --- AI ENGINE: Google Gemini 3.8 Flash (Server-Side Cloud VPN Proxy) ---
# Automatically bypassed via European Cloud Edge (europe-west2) to work from any region without external VPN.
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.8-flash
GEMINI_TUNNEL_PROXY_LOCATION=europe-west2

# --- ZERO-COST AI: Embeddings (Local CPU sentence-transformers) ---
# paraphrase-multilingual-MiniLM-L12-v2 produces 384-dimensional dense vectors
# Runs 100% locally on CPU with zero API costs and great multilingual performance (RU, EN, etc.)
EMBEDDING_MODEL=paraphrase-multilingual-MiniLM-L12-v2
EMBEDDING_DIMENSIONS=384

# --- ZERO-COST AI: Voice Synthesis (Edge-TTS) ---
# High quality Microsoft neural voices with zero cost and no API keys required.
# Popular Russian voices for meditation & mindfulness:
# - ru-RU-DmitryNeural (calm male baritone, great for guided meditation)
# - ru-RU-SvetlanaNeural (soft feminine, relaxing tempo)
DEFAULT_TTS_VOICE=ru-RU-DmitryNeural

# --- Telegram Bot (aiogram 3.x) ---
# Primary bot token obtained via @BotFather
TELEGRAM_BOT_TOKEN=your_telegram_bot_father_token_here

# --- Frontend (Next.js) ---
NEXT_PUBLIC_API_URL=http://localhost:8000/api
